[Unit]
Description=GPUlink PostgreSQL verified backup
Requires=docker.service
After=docker.service
ConditionPathExists=/etc/gpulink/postgres.env
ConditionPathExists=/opt/gpulink/deploy/digitalocean/compose.yml

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/gpulink/scripts/backup-postgres.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true

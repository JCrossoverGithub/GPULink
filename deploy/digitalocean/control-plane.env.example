GPULINK_CONTROL_HOST=0.0.0.0
GPULINK_CONTROL_PORT=8088

# DigitalOcean Docker deployments use PostgreSQL as authoritative storage.
GPULINK_CONTROL_DATABASE=postgres
GPULINK_DATABASE_URL=postgresql://gpulink:replace-with-postgres-password@postgres:5432/gpulink

# Retained for compatibility and historical SQLite tooling.
# PostgreSQL is authoritative when GPULINK_CONTROL_DATABASE=postgres.
GPULINK_CONTROL_DATA_PATH=/var/lib/gpulink/control-plane.sqlite

GPULINK_CONTROL_HEARTBEAT_TIMEOUT_MS=15000
GPULINK_CONTROL_LEASE_DURATION_MS=30000
GPULINK_CONTROL_SCHEDULER_INTERVAL_MS=1000
GPULINK_CONTROL_VRAM_SAFETY_MIB=512

GPULINK_CLIENT_TOKEN=replace-with-output-from-openssl-rand-hex-32
GPULINK_WORKER_TOKEN=replace-with-different-output-from-openssl-rand-hex-32
GPULINK_ADMIN_TOKEN=replace-with-third-output-from-openssl-rand-hex-32

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>GPULink.Client</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>GPULink contributors</Authors>
    <Description>General-purpose .NET client for GPULink session allocation, streaming, and lifecycle operations.</Description>
    <PackageTags>gpu;distributed;streaming;client;sdk</PackageTags>
    <PackageProjectUrl>https://github.com/JCrossoverGithub/GPULink</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JCrossoverGithub/GPULink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

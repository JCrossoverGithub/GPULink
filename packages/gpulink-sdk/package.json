{
  "name": "@gpulink/client",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the public GPULink application API",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 spec/client.mjs spec/data-plane.mjs spec/reliability.mjs spec/readiness-v2.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}

{
  "name": "@gpulink/client",
  "version": "0.1.0",
  "private": false,
  "description": "TypeScript SDK for the public GPULink application API",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 spec/client.mjs spec/data-plane.mjs spec/reliability.mjs spec/readiness-v2.mjs spec/external-consumer.mjs spec/high-level-session.mjs spec/job-wait.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCrossoverGithub/GPULink.git",
    "directory": "packages/gpulink-sdk"
  },
  "homepage": "https://gpulink.dev/",
  "bugs": {
    "url": "https://github.com/JCrossoverGithub/GPULink/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "preview"
  }
}

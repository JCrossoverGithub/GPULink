{
  "name": "gpulink",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source platform for securely scheduling and serving GPU workloads across personal computers.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "control-plane": "node src/control-plane/main.mjs",
    "worker": "node src/worker/main.mjs",
    "cli": "node src/cli/main.mjs",
    "build:cli": "node scripts/build-cli-package.mjs",
    "build:cli:release": "node scripts/build-cli-release.mjs",
    "test:cli:release": "node scripts/acceptance/cli-release-install.mjs",
    "test:sdk:release": "node scripts/acceptance/sdk-release-install.mjs",
    "test": "node --test --test-concurrency=1 \"test/**/*.mjs\" \"packages/gpulink-adapter-sdk/spec/*.test.mjs\"",
    "test:watch": "node --test --watch \"test/**/*.mjs\" \"packages/gpulink-adapter-sdk/spec/*.test.mjs\"",
    "check": "node --check src/control-plane/main.mjs && node --check src/worker/main.mjs && node --check src/cli/main.mjs && node --check scripts/migrate-sqlite-to-postgres.mjs && node --test --test-concurrency=1 \"test/**/*.mjs\" \"packages/gpulink-adapter-sdk/spec/*.test.mjs\"",
    "test:postgres": "node --test test/postgres-persistence.test.mjs",
    "migrate:sqlite-to-postgres": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "ws": "8.22.0"
  }
}

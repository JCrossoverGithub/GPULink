# NON-SECRET TEMPLATE ONLY. Supply separate role-scoped protected environment files.
# Never commit real credentials or source this complete template into both hosts.
# Generate four independent random values (32+ characters) outside source control.
# REPLACE_ME intentionally FAILS configuration validation until provisioned.
GPULINK_CONTROL_HOST=127.0.0.1
GPULINK_CONTROL_PORT=8088
GPULINK_CONTROL_DATA_PATH=./data/control-plane.sqlite
GPULINK_CLIENT_TOKEN=REPLACE_ME
GPULINK_WORKER_TOKEN=REPLACE_ME
GPULINK_ADMIN_TOKEN=REPLACE_ME
GPULINK_DATA_PLANE_SIGNING_KEY=REPLACE_ME
GPULINK_CONTROL_HEARTBEAT_TIMEOUT_MS=15000
GPULINK_CONTROL_LEASE_DURATION_MS=30000
GPULINK_CONTROL_SCHEDULER_INTERVAL_MS=1000
GPULINK_CONTROL_VRAM_SAFETY_MIB=512
# Worker: loopback only in local development; remote Host A requires trusted HTTPS.
GPULINK_CONTROL_PLANE_URL=http://127.0.0.1:8088
GPULINK_WORKER_NAME=example-worker
GPULINK_WORKER_HEARTBEAT_INTERVAL_MS=5000
GPULINK_WORKER_ASSIGNMENT_INTERVAL_MS=1000
GPULINK_WORKER_CAPABILITY_PROBE_INTERVAL_MS=300000
GPULINK_WORKER_MODEL_INVENTORY_INTERVAL_MS=300000
GPULINK_WORKER_CAPABILITIES=diagnostic.echo,diagnostic.gpu-status
GPULINK_MODEL_CACHE_ROOT=/var/lib/gpulink/models
GPULINK_MODEL_CACHE_MANIFEST=/var/lib/gpulink/models/manifest.json
GPULINK_BENCHMARK_PYTHON=/opt/gpulink/runtime/benchmark/bin/python
GPULINK_BENCHMARK_TIMEOUT_MS=60000
# Operator CLI: nonlocal control plane, never plain HTTP or redirected bearer auth.
GPULINK_URL=https://gpulink.example.invalid
